# Copy this file to .env and add your OpenRouter API key there.
LLM_MODEL=openrouter/google/gemini-2.5-flash:free
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=replace_with_your_openrouter_api_key

# Optional Ollama fallback. Start it with `docker compose -f compose.ollama.yml up -d`
# and pull the model with `docker compose -f compose.ollama.yml exec ollama ollama pull qwen2.5:3b`.
LLM_FALLBACK_MODEL=ollama/qwen2.5:3b
LLM_FALLBACK_API_BASE=http://localhost:11434
LLM_FALLBACK_API_KEY=ollama

LLM_TIMEOUT_SECONDS=30
LLM_FALLBACK_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=0
LLM_MAX_INPUT_TOKENS=8000
LLM_MAX_OUTPUT_TOKENS=1000

# PostgreSQL used by both the pipeline (write) and the backend (read-only).
# DATABASE_URL takes precedence; LEARNGUARD_PG_DSN is the pipeline-compatible name.
# Backend user only needs SELECT on ml_predictions.
DATABASE_URL=postgresql://learnguard:replace_me@localhost:5432/learnguard
LEARNGUARD_PG_DSN=postgresql://learnguard:replace_me@localhost:5432/learnguard

# Published evaluation scorecards (eval-report.v1), written by the ml-data
# pipeline and read-only for the backend. Left empty, the /evaluations
# endpoints respond 503 evaluations_dir_not_configured.
EVALUATIONS_DIR=../ml-data/artifacts/evaluations

# UI-triggered evaluation runs (POST /evaluations/run). ML_REPO_DIR points
# at the ml-data repo that owns the learnguard CLI; left empty, the trigger
# endpoint responds 503 ml_runner_not_configured. The artifact dirs are
# relative to ML_REPO_DIR (defaults shown). ML_EVAL_PG_DSN falls back to
# DATABASE_URL when empty. EVAL_JUDGE_SAMPLE = briefs judged by the LLM
# gate per run (the run takes ~1-2 minutes: SHAP + Gemini judge).
ML_REPO_DIR=../ml-data
ML_EVAL_LEARNGUARD_BIN=.venv/bin/learnguard
ML_EVAL_MODEL_DIR=artifacts/model-runs/local-model-v2-shap
ML_EVAL_PREPROCESSING_DIR=artifacts/preprocessing-runs/local-pre-v1
ML_EVAL_PG_DSN=
EVAL_JUDGE_SAMPLE=4

# Raw OULAD CSV dataset directory (studentInfo.csv, studentVle.csv,
# assessments.csv, studentAssessment.csv, vle.csv) used by
# GET /predictions/{module}/{presentation}/{student_key}/activity.
# Left empty (or pointing at a missing directory), that endpoint
# responds 503 oulad_data_not_configured.
OULAD_DATA_DIR=
